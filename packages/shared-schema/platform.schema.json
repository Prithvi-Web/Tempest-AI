{
  "$defs": {
    "DescribeResult": {
      "additionalProperties": false,
      "properties": {
        "methods": {
          "items": {
            "$ref": "#/$defs/PlatformMethod"
          },
          "type": "array"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "protocol_version",
        "methods"
      ],
      "type": "object"
    },
    "HttpRequest": {
      "additionalProperties": false,
      "description": "platform.http params.request — one webview API call crossing boundary E.",
      "properties": {
        "body_base64": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH",
            "HEAD",
            "OPTIONS"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "body_base64"
      ],
      "type": "object"
    },
    "HttpResult": {
      "additionalProperties": false,
      "description": "platform.http result — status, media type, and base64 body.",
      "properties": {
        "body_base64": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "content_type",
        "body_base64"
      ],
      "type": "object"
    },
    "PingResult": {
      "additionalProperties": false,
      "properties": {
        "node_version": {
          "type": "string"
        },
        "ok": {
          "enum": [
            true
          ],
          "type": "boolean"
        },
        "pid": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "ok",
        "pid",
        "protocol_version",
        "node_version"
      ],
      "type": "object"
    },
    "PlatformError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "data": {
          "type": "object"
        },
        "diagnostic_id": {
          "description": "L15.3: every surfaced failure carries an id a human can quote and a log can find.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        }
      },
      "required": [
        "code",
        "message",
        "diagnostic_id"
      ],
      "type": "object"
    },
    "PlatformMethod": {
      "description": "Every method that may cross boundary E. C5 extends this list.",
      "enum": [
        "platform.ping",
        "platform.describe",
        "platform.shutdown",
        "platform.http"
      ],
      "type": "string"
    },
    "PlatformRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "jsonrpc": {
          "enum": [
            "2.0"
          ],
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/PlatformMethod"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    "PlatformResponse": {
      "additionalProperties": false,
      "description": "Exactly ONE of result/error is present — stated in prose because a oneOf here produces hostile typify output; boundary-validate.mjs enforces it at runtime, both directions, in production.",
      "properties": {
        "error": {
          "$ref": "#/$defs/PlatformError"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "jsonrpc": {
          "enum": [
            "2.0"
          ],
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "description": "Bumped only by a commit that regenerates every consumer.",
      "enum": [
        "e1"
      ],
      "type": "string"
    },
    "ReasonCode": {
      "description": "Machine-readable blocking reasons attached to every UNPROVEN verdict (Law L2).",
      "enum": [
        "TARGET_UNREACHABLE",
        "ENV_REPRODUCTION_FAILED",
        "HARNESS_SYNTHESIS_FAILED",
        "SYNTHESIS_DECLINED",
        "UNINTERCEPTABLE_EFFECT",
        "NONDETERMINISTIC_BASE",
        "SANDBOX_UNAVAILABLE",
        "VALUE_UNSERIALIZABLE",
        "RECORD_REPLAY_UNAVAILABLE"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ShutdownResult": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "enum": [
            true
          ],
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Boundary E (Rust host <-> Node platform sidecar), JSON-RPC 2.0 over a Unix domain socket with Content-Length framing. Generated — do not edit; run `make gen-contracts`.",
  "title": "TempestPlatformBoundary",
  "type": "object"
}
