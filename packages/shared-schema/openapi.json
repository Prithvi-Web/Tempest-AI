  "info": {
    "description": "Ingests CLI-produced run bundles and serves them to the dashboard. One producer, many renderers \u2014 this API never re-derives verdicts.",
    "title": "Tempest AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/divergences/{divergence_id}": {
      "get": {
        "operationId": "getDivergence",
        "parameters": [
          {
            "in": "path",
            "name": "divergence_id",
            "required": true,
            "schema": {
              "title": "Divergence Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DivergenceDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Divergence",
        "tags": [
          "divergences"
        ]
      }
    },
    "/v1/divergences/{divergence_id}/repro.py": {
      "get": {
        "description": "The standalone reproduction script, byte-for-byte as the bundle carried it.",
        "operationId": "getDivergenceRepro",
        "parameters": [
          {
            "in": "path",
            "name": "divergence_id",
            "required": true,
            "schema": {
              "title": "Divergence Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/x-python": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "text/x-python": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "text/x-python": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Divergence Repro",
        "tags": [
          "divergences"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
